"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "3. Invocar `rectangulo(anchx,largx)` desde el programa principal con las dimensiones\ndeseadas.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "3. Invocar `rectangulo(anchx,largx)` desde el programa principal con las dimensiones\ndeseadas.",
