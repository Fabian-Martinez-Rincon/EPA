"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Escriba un proceso que le permita al robot realizar un cuadrado a partir de la\nesquina donde está parado, girando en la dirección de las agujas del reloj y\nrecibiendo como dato la longitud del lado.",
"fontSize": 17,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 14,
"containerId": null,
"originalText": "Escriba un proceso que le permita al robot realizar un cuadrado a partir de la\nesquina donde está parado, girando en la dirección de las agujas del reloj y\nrecibiendo como dato la longitud del lado.",
"lineHeight": 1.25
},
