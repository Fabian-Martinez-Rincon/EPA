"version": 1,
"versionNonce": 1780210481,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Programe al robot para que realice cada uno de los cuatro recorridos de la figura\n6.7 (cuatro variantes de recorridos en forma de escalera sobre la grilla de la\nciudad, cada una con distinta cantidad y disposición de escalones).",
"fontSize": 17,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 14,
"containerId": null,
"originalText": "Programe al robot para que realice cada uno de los cuatro recorridos de la figura\n6.7 (cuatro variantes de recorridos en forma de escalera sobre la grilla de la\nciudad, cada una con distinta cantidad y disposición de escalones).",
"lineHeight": 1.25
},
