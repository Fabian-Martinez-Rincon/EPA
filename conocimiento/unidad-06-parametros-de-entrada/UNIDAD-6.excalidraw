"version": 1,
"versionNonce": 913976089,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en el recorrido que traza el robot.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en el recorrido que traza el robot.",
"lineHeight": 1.25
},
{
