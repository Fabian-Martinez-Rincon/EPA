"locked": false,
"text": "→ Restricciones: debe reutilizarse el proceso `cuadrado(E lado:numero)` del ejercicio\n1, sin reimplementar el trazado del cuadrado.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: debe reutilizarse el proceso `cuadrado(E lado:numero)` del ejercicio\n1, sin reimplementar el trazado del cuadrado.",
"lineHeight": 1.25
},
