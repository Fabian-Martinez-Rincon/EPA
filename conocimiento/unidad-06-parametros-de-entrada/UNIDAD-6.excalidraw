},
{
"id": "tex_f883590201be",
"type": "text",
"x": 2224,
"y": 740.5,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
