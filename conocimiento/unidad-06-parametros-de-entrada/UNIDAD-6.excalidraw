"versionNonce": 1455783213,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; el punto de partida (1,1) y los\ntamaños de los cuadrados están fijos en el enunciado/figura.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; el punto de partida (1,1) y los\ntamaños de los cuadrados están fijos en el enunciado/figura.",
"lineHeight": 1.25
},
{
