"version": 1,
"versionNonce": 1144047632,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "3. Inicializar `anchx := 1`, `largx := 15`, `numer := -4`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "3. Inicializar `anchx := 1`, `largx := 15`, `numer := -4`.",
"lineHeight": 1.25
},
