"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: el rectángulo debe comenzar en la esquina donde el robot ya está\nparado al momento de invocar el proceso.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: el rectángulo debe comenzar en la esquina donde el robot ya está\nparado al momento de invocar el proceso.",
"lineHeight": 1.25
},
