},
{
"id": "tex_a2c8126ec3fa",
"type": "text",
"x": 1158,
"y": 568.25,
"width": 199.64,
"height": 17.5,
"angle": 0,
"strokeColor": "#495057",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
