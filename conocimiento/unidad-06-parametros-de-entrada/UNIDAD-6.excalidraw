},
{
"id": "tex_fe68824bf589",
"type": "text",
"x": 3274,
"y": 709.75,
"width": 808,
"height": 18.75,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
