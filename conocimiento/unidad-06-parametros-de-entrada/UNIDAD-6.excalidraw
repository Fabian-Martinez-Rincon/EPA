"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "2. Repetir 4 veces: invocar `cuadrado(ancho)` y luego incrementar `ancho` en 1, sin\nreposicionar al robot.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "2. Repetir 4 veces: invocar `cuadrado(ancho)` y luego incrementar `ancho` en 1, sin\nreposicionar al robot.",
"lineHeight": 1.25
},
