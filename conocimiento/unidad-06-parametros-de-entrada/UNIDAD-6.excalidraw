"locked": false,
"text": "1. Declarar `proceso Avenida(E Numero:numero; E pasos:numero)`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Declarar `proceso Avenida(E Numero:numero; E pasos:numero)`.",
"lineHeight": 1.25
},
