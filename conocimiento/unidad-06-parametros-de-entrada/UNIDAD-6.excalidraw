"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: valores negativos de pasos no deben mover al robot; valores mayores a\n99 se acotan a 99; el número de avenida siempre es válido (entre 1 y 100), no requiere\nvalidación.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: valores negativos de pasos no deben mover al robot; valores mayores a\n99 se acotan a 99; el número de avenida siempre es válido (entre 1 y 100), no requiere\nvalidación.",
"lineHeight": 1.25
},
