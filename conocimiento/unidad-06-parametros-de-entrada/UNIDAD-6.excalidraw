"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Cómo lo resolvemos:",
"fontSize": 14,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 11,
"containerId": null,
"originalText": "Cómo lo resolvemos:",
