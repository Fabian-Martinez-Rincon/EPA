"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 160300753,
"version": 1,
"versionNonce": 2038664903,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Qué tenemos / qué pide:",
"fontSize": 14,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 11,
"containerId": null,
"originalText": "Qué tenemos / qué pide:",
"lineHeight": 1.25
},
{
"id": "tex_b1487e98585d",
"type": "text",
"x": 1174,
"y": 591.75,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 1170613960,
"version": 1,
"versionNonce": 644955730,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: la longitud del lado del cuadrado, recibida por el proceso a través de un\nparámetro de entrada (`E`).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: la longitud del lado del cuadrado, recibida por el proceso a través de un\nparámetro de entrada (`E`).",
"lineHeight": 1.25
},
{
"id": "tex_de8f2a89aa0c",
"type": "text",
"x": 1174,
"y": 633.25,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 662088422,
"version": 1,
"versionNonce": 1226412365,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en el recorrido que traza el robot sobre\nla ciudad.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en el recorrido que traza el robot sobre\nla ciudad.",
"lineHeight": 1.25
},
{
"id": "tex_224a1ab516d5",
"type": "text",
"x": 1174,
"y": 674.75,
"width": 808,
"height": 56.25,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 808919135,
"version": 1,
"versionNonce": 1630719164,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: el robot debe girar en el sentido de las agujas del reloj (es decir,\nusando `derecha`) y el cuadrado debe comenzar en la esquina donde el robot ya está\nparado al momento de invocar el proceso.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: el robot debe girar en el sentido de las agujas del reloj (es decir,\nusando `derecha`) y el cuadrado debe comenzar en la esquina donde el robot ya está\nparado al momento de invocar el proceso.",
"lineHeight": 1.25
},
{
"id": "tex_caf4716ba2e5",
"type": "text",
"x": 1158,
"y": 745.0,
"width": 164.92,
"height": 17.5,
"angle": 0,
"strokeColor": "#495057",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
