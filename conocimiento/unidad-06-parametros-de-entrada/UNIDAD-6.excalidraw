"link": null,
"locked": false,
"text": "1. Inicializar `ancho := 1`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Inicializar `ancho := 1`.",
"lineHeight": 1.25
},
{
"id": "tex_40d86732367d",
