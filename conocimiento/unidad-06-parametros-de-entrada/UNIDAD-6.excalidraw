"versionNonce": 1202819651,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Qué tenemos / qué pide:",
"fontSize": 14,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 11,
"containerId": null,
"originalText": "Qué tenemos / qué pide:",
"lineHeight": 1.25
},
{
"id": "tex_cec2d45a214a",
"type": "text",
"x": 3274,
"y": 570.5,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 661690905,
"version": 1,
"versionNonce": 11327563,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: las dos dimensiones del rectángulo (ancho y largo/alto), recibidas por el\nproceso a través de dos parámetros de entrada (`E`).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: las dos dimensiones del rectángulo (ancho y largo/alto), recibidas por el\nproceso a través de dos parámetros de entrada (`E`).",
"lineHeight": 1.25
},
{
"id": "tex_804536b81be9",
"type": "text",
"x": 3274,
"y": 612.0,
"width": 808,
"height": 18.75,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
