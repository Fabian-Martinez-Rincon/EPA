"versionNonce": 1513469891,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; los tamaños y la cantidad de\nrectángulos están fijos en el enunciado/figura.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; los tamaños y la cantidad de\nrectángulos están fijos en el enunciado/figura.",
"lineHeight": 1.25
},
