"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "3. Mientras no se llegue al borde de la ciudad y falten flores por juntar: levantar\ntodas las flores de la esquina actual y avanzar.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "3. Mientras no se llegue al borde de la ciudad y falten flores por juntar: levantar\ntodas las flores de la esquina actual y avanzar.",
