"version": 1,
"versionNonce": 1028987252,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "8. Girar una vez más a la derecha (cambiando de rumbo) y repetir 2 veces más el mismo\npar de invocaciones.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "8. Girar una vez más a la derecha (cambiando de rumbo) y repetir 2 veces más el mismo\npar de invocaciones.",
"lineHeight": 1.25
},
