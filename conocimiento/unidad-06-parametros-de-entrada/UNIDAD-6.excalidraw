"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: el número de avenida y la cantidad de pasos a dar, ambos recibidos por el\nmódulo como parámetros de entrada (`E`).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: el número de avenida y la cantidad de pasos a dar, ambos recibidos por el\nmódulo como parámetros de entrada (`E`).",
"lineHeight": 1.25
},
