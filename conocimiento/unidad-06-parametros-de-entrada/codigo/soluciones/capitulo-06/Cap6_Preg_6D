{Ejercitación, ejercicio 6.d): Utilice el proceso de 6.a) para recorrer las avenidas pares de la ciudad.}

programa parametros
procesos
  proceso RecorrerAvenida(E numAv:numero)
  comenzar
    Pos(numAv,1)
    repetir 99
      mover
  fin
areas
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    av:numero
  comenzar
    av:=2
    repetir 50
      RecorrerAvenida(av)
      av:=av+2
  fin
variables
  robin: robot1
comenzar
  AsignarArea(robin,ciudad)
  Iniciar(robin,1,1)
fin