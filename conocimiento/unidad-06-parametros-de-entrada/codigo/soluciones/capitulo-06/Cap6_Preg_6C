{Ejercitación, ejercicio 6.c): Utilice el proceso de 6.a) para recorrer las avenidas 5, 6, 7 … 15.}

programa parametros
procesos
  proceso RecorrerAvenida(E numAv:numero)
  comenzar
    Pos(numAv,1)
    repetir 99
      mover
  fin
areas
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    av:numero
  comenzar
    av:=5
    repetir 11
      RecorrerAvenida(av)
      av:=av+1
  fin
variables
  robin: robot1
comenzar
  AsignarArea(robin,ciudad)
  Iniciar(robin,1,1)
fin