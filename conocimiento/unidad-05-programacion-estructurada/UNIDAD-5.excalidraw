"version": 1,
"versionNonce": 1259869055,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; el proceso se invoca desde la\nesquina donde esté parado el robot al momento de la llamada.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; el proceso se invoca desde la\nesquina donde esté parado el robot al momento de la llamada.",
"lineHeight": 1.25
},
{
"id": "tex_dd37a31e690f",
"type": "text",
"x": 1174,
"y": 612.0,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
