{
"id": "tex_fc84e8680898",
"type": "text",
"x": 2188,
"y": 423.25,
"width": 864,
"height": 297.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
