{
"id": "tex_dccf1ccffc64",
"type": "text",
"x": 4288,
"y": 423.25,
"width": 864,
"height": 297.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
