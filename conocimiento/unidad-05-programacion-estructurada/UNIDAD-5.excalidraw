"version": 1,
"versionNonce": 168347454,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en el recorrido trazado por el robot (un\ncuadrado de 2x2 esquinas).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en el recorrido trazado por el robot (un\ncuadrado de 2x2 esquinas).",
"lineHeight": 1.25
},
{
