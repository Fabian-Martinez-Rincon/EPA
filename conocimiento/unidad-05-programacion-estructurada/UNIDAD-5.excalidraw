"locked": false,
"text": "1. Definir el proceso `cuadrado`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Definir el proceso `cuadrado`.",
"lineHeight": 1.25
},
{
"id": "tex_a393af3a8994",
"type": "text",
"x": 1174,
"y": 751.25,
"width": 808,
