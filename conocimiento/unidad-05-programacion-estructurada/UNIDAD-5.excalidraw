"updated": 1,
"link": null,
"locked": false,
"text": "Qué tenemos / qué pide:",
"fontSize": 14,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 11,
"containerId": null,
"originalText": "Qué tenemos / qué pide:",
"lineHeight": 1.25
},
{
"id": "tex_c4dc20899169",
"type": "text",
"x": 1174,
"y": 570.5,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
