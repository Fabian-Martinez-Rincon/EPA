"version": 1,
"versionNonce": 1273339856,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "2. Para el recorrido a): repetir \"rectángulo + `Pos(1,PosCa+5)`\" tres veces.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "2. Para el recorrido a): repetir \"rectángulo + `Pos(1,PosCa+5)`\" tres veces.",
"lineHeight": 1.25
},
{
"id": "tex_67c2f209a540",
"type": "text",
"x": 4324,
"y": 1029.0,
"width": 808,
"height": 18.75,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
