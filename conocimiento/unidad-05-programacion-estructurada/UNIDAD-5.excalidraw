"version": 1,
"versionNonce": 84341477,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "3. Para el recorrido b): repetir \"rectángulo + `Pos(PosAv+1,PosCa+1)`\" tres veces.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "3. Para el recorrido b): repetir \"rectángulo + `Pos(PosAv+1,PosCa+1)`\" tres veces.",
"lineHeight": 1.25
},
{
"id": "tex_88af254ea690",
"type": "text",
"x": 4324,
"y": 1051.75,
"width": 808,
"height": 56.25,
"angle": 0,
