{Ejercicio 1 del Capítulo 5: Escriba un proceso que le permita al robot realizar un cuadrado de lado 2 girando en la dirección de las agujas del reloj.}

programa prueba
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso cuadrado
  comenzar
    repetir 4
      repetir 3
        mover
      derecha
  fin
areas 
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    vacias: numero
  comenzar
    vacias:=0
    cuadrado
  fin
variables
  robin:robot1
comenzar
  AsignarArea(robin,ciudad)
  Iniciar(robin,1,1)
fin