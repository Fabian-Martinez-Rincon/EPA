"updated": 1,
"link": null,
"locked": false,
"text": "1. Empezar con lado 99 en la esquina (1,1).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Empezar con lado 99 en la esquina (1,1).",
"lineHeight": 1.25
},
{
"id": "tex_f79607951f29",
"type": "text",
"x": 4324,
"y": 831.25,
"width": 808,
"height": 75.0,
"angle": 0,
"strokeColor": "#1e1e1e",
