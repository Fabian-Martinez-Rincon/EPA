{Nota: enunciado original no identificado; descripción inferida del código. Recorre la ciudad esquina por esquina juntando flores y papeles hasta hallar una esquina con 25 flores o más; al encontrarla se traslada a la esquina (1,75) y avanza tantos pasos como papeles había juntado en el trayecto, informando esa cantidad de pasos.}

programa Cap7Preg10
procesos
  proceso JuntarPapeles(ES PasosPapeles:numero;ES CantFlores:numero)
  comenzar
    CantFlores:=0
    mientras(HayPapelEnLaEsquina)|(HayFlorEnLaEsquina)
      si(HayPapelEnLaEsquina)
        tomarPapel
        PasosPapeles:=PasosPapeles+1
      si(HayFlorEnLaEsquina)
        tomarFlor
        CantFlores:=CantFlores+1
    si(CantFlores>=25)
      Pos(1,75)
      derecha
      repetir PasosPapeles
        mover   
  fin
  proceso avenida
  comenzar
    mover  
  fin
areas
  ciudad:AreaC(1,1,100,100)
robots
  robot robot1
  variables
    NPasos:numero
    NFlores:numero
  comenzar
    NFlores:=0
    mientras(PosAv<99)&(NFlores<=25)
      NPasos:=0
      mientras(PosCa<99)&(NFlores<=25)
        JuntarPapeles(NPasos,NFlores)
        mover
      Pos(PosAv+1,1)
    Informar(NPasos)
  fin
variables
  R-Info:robot1
comenzar
  AsignarArea(R-Info,ciudad)
  Iniciar(R-Info,1,1)
fin