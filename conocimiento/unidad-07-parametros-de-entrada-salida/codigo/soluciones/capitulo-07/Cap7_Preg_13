{Nota: enunciado original no identificado; descripción inferida del código. Recorre la avenida 8 recogiendo todas las flores y papeles que encuentra e informa esos totales; luego, desde (1,1), traza un rectángulo cuyo ancho es la cantidad de flores y cuyo alto es la cantidad de papeles recolectados.}

programa Cap7Pregunta13
procesos
  proceso rectangulo(ES NUMFLORES:numero; ES NUMPAPELES:numero)
  comenzar
    Pos(1,1)
    repetir 2
      repetir (NUMFLORES)
        mover
      derecha
      repetir (NUMPAPELES)
        mover
      derecha
  fin
  proceso juntarTodo(ES FLORES:numero;ES PAPELES:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)|(HayPapelEnLaEsquina)
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        FLORES:=FLORES+1
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        PAPELES:=PAPELES+1
      mover
  fin    
areas
  ciudad:AreaC(1,1,100,100)
robots
  robot robot1
  variables
    flores,papeles:numero
  comenzar
    flores:=0
    papeles:=0
    Pos(8,1) 
    juntarTodo(flores,papeles)
    Informar(flores,papeles)
    Pos(1,1)
    rectangulo(flores,papeles)
  fin
variables
  R-Info:robot1
comenzar
  AsignarArea(R-Info,ciudad)
  Iniciar(R-Info,1,1)
fin