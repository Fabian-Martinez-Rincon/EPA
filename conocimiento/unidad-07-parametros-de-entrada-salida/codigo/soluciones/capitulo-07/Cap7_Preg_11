{Nota: enunciado original no identificado; descripción inferida del código. Recorre 10 avenidas con un recorrido cada vez más largo (8, 10, 12... pasos), contando en cada una cuántas esquinas tienen al menos el doble de flores que de papeles e informando ese conteo por avenida; al finalizar informa el total de flores y de papeles recolectados en todo el trayecto.}

programa Cap7Preg11
procesos
  proceso JuntarTodo(ES FLORES:numero;ES PAPELES:numero;ES DOBLE:numero)
  variables
    DOBLEFLORES:numero
    CASIPAPELES:numero
  comenzar
    DOBLEFLORES:=0
    CASIPAPELES:=0
    mientras((HayFlorEnLaEsquina)|(HayPapelEnLaEsquina))
      si(HayFlorEnLaEsquina)
        tomarFlor
        FLORES:=FLORES+1
        DOBLEFLORES:=DOBLEFLORES+1
      si(HayPapelEnLaEsquina)
        tomarPapel
        PAPELES:=PAPELES+1
        CASIPAPELES:=CASIPAPELES+1
    si(DOBLEFLORES>=(CASIPAPELES+CASIPAPELES))&(DOBLEFLORES>0)
      DOBLE:=DOBLE+1
  fin
  proceso avenida(E pasos:numero;ES NFLORES:numero;ES NPAPELES:numero;ES NDOBLE:numero)
  comenzar
    repetir pasos
      JuntarTodo(NFLORES,NPAPELES,NDOBLE)
      mover
    JuntarTodo(NFLORES,NPAPELES,NDOBLE)
  fin
areas
  ciudad:AreaC(1,1,100,100)
robots
  robot robot1
  variables
    NPASOS:numero
    flores,papeles:numero
    dobleFlores:numero
  comenzar
    derecha
    NPASOS:=8
    flores:=0
    papeles:=0
    repetir 10
      dobleFlores:=0
      avenida(NPASOS,flores,papeles,dobleFlores)
      Informar(dobleFlores)
      NPASOS:=NPASOS+2
      Pos(1,PosCa+1)
    Informar(flores)
    Informar(papeles)
  fin
variables
  R-Info:robot1
comenzar
  AsignarArea(R-Info,ciudad)
  Iniciar(R-Info,1,1)
fin