{Demo personal fuera del libro (no es un enunciado del capítulo): reutiliza el proceso SumarFloresEsquina del Ejemplo 7.1 pero, a diferencia de aquel, arranca en (1,1) y solo recorre 9 esquinas ("Numero random para probar"), informando el total de flores sumadas en ese tramo corto, a modo de prueba rápida del parámetro de entrada/salida.}

programa Cap7Ejemplo1

procesos
  proceso SumarFloresEsquina (ES flores: numero)
  variables
    aux: numero
  comenzar
    aux := 0
    mientras HayFlorEnLaEsquina
      tomarFlor
      aux := aux + 1
      flores := flores + 1
    repetir aux
      depositarFlor
  fin

areas
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    totalFlores: numero
  comenzar
    totalFlores := 0
    repetir 9 {Numero random para probar}
      SumarFloresEsquina(totalFlores)
      mover
    SumarFloresEsquina(totalFlores)
    Informar(totalFlores)
  fin

variables
  R-info: robot1

comenzar
  AsignarArea(R-info, ciudad)
  Iniciar(R-info, 1, 1)
fin