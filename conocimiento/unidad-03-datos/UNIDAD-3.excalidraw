"version": 1,
"versionNonce": 1431350118,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: la posición (avenida, calle) donde el robot se detiene, informada con\n`Informar(PosAv,PosCa)`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: la posición (avenida, calle) donde el robot se detiene, informada con\n`Informar(PosAv,PosCa)`.",
"lineHeight": 1.25
},
{
