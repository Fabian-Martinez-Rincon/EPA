"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; recorrido sobre la calle 2 (avenida\nvariable, de 1 a 100).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; recorrido sobre la calle 2 (avenida\nvariable, de 1 a 100).",
"lineHeight": 1.25
},
{
"id": "tex_57884046baa8",
"type": "text",
"x": 5374,
"y": 612.0,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
