"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: la cantidad de flores encontradas (20 si se alcanzaron, o menos si la calle\nse acabó antes), informada con `Informar`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: la cantidad de flores encontradas (20 si se alcanzaron, o menos si la calle\nse acabó antes), informada con `Informar`.",
"lineHeight": 1.25
},
{
