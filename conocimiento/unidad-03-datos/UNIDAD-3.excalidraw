"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: no se garantiza que existan 10 papeles, así que el recorrido debe\npoder terminar igual al llegar al final de la calle.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: no se garantiza que existan 10 papeles, así que el recorrido debe\npoder terminar igual al llegar al final de la calle.",
"lineHeight": 1.25
},
