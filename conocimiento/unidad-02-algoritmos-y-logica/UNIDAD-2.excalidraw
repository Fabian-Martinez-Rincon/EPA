"frameId": null,
"roundness": null,
"seed": 1255052527,
"version": 1,
"versionNonce": 807753007,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: una esquina \"libre\" es una esquina sin flor y sin papel; el recorrido\ndebe cubrir todas las calles de la ciudad.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: una esquina \"libre\" es una esquina sin flor y sin papel; el recorrido\ndebe cubrir todas las calles de la ciudad.",
"lineHeight": 1.25
},
{
"id": "tex_9be37906a8a4",
"type": "text",
"x": 6408,
"y": 686.25,
"width": 164.92,
