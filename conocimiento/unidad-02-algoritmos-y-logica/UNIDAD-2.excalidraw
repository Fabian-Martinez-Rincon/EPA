"versionNonce": 892233239,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; punto de partida (65,50) y destino\n(avenida 23) fijos en el enunciado.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; punto de partida (65,50) y destino\n(avenida 23) fijos en el enunciado.",
"lineHeight": 1.25
},
{
"id": "tex_01b500e266d0",
"type": "text",
"x": 124,
"y": 633.25,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
