"versionNonce": 805311477,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "2. Girar tres veces a la derecha para quedar orientado hacia avenidas decrecientes.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "2. Girar tres veces a la derecha para quedar orientado hacia avenidas decrecientes.",
"lineHeight": 1.25
},
