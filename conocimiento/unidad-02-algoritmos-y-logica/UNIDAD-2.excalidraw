},
{
"id": "tex_b0d2fa928906",
"type": "text",
"x": 124,
"y": 591.75,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
