"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "2. Reposicionarse en (30,30) y recorrer un segundo cuadrado igual, esta vez con\n`tomarFlor` y `tomarPapel` en cada esquina intermedia.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
