"versionNonce": 1425714431,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en el estado final de la ciudad (papeles\ndepositados en la calle 50, entre las avenidas 23 y 65).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en el estado final de la ciudad (papeles\ndepositados en la calle 50, entre las avenidas 23 y 65).",
"lineHeight": 1.25
},
