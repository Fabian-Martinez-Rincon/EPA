"version": 1,
"versionNonce": 1338537322,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en los papeles depositados en las esquinas\nlibres.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en los papeles depositados en las esquinas\nlibres.",
"lineHeight": 1.25
},
{
"id": "tex_5ff0e2c38af7",
"type": "text",
"x": 6424,
"y": 634.75,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
