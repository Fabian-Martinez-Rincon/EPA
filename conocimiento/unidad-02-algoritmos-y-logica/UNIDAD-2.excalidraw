"version": 1,
"versionNonce": 1405867964,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución.",
"lineHeight": 1.25
},
{
"id": "tex_17587e504b28",
"type": "text",
"x": 6424,
"y": 593.25,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
"roughness": 0,
