"updated": 1,
"link": null,
"locked": false,
"text": "1. Reposicionar el robot en (10,1) con `Pos` y girar a la derecha (orientación hacia\navenidas crecientes).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Reposicionar el robot en (10,1) con `Pos` y girar a la derecha (orientación hacia\navenidas crecientes).",
"lineHeight": 1.25
},
