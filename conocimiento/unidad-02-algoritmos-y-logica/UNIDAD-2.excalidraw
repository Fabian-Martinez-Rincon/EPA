"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "Escriba un programa que le permita al robot recorrer la avenida 10, depositando\nuna flor en cada esquina. Si en algún momento del recorrido se queda sin flores\nen la bolsa, debe seguir caminando (sin depositar) hasta terminar la avenida.",
"fontSize": 17,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 14,
"containerId": null,
"originalText": "Escriba un programa que le permita al robot recorrer la avenida 10, depositando\nuna flor en cada esquina. Si en algún momento del recorrido se queda sin flores\nen la bolsa, debe seguir caminando (sin depositar) hasta terminar la avenida.",
"lineHeight": 1.25
},
