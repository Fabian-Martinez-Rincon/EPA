"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución.",
"lineHeight": 1.25
},
{
"id": "tex_e6c8c9941b1f",
"type": "text",
"x": 5374,
"y": 635.75,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
