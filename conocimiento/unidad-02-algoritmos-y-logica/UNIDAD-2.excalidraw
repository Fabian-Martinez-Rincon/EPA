"versionNonce": 1719110162,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: ninguna; el resultado se observa en las flores/papeles recogidos durante el\nrecorrido y el papel dejado en cada vértice (si había disponible).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: ninguna; el resultado se observa en las flores/papeles recogidos durante el\nrecorrido y el papel dejado en cada vértice (si había disponible).",
"lineHeight": 1.25
},
{
"id": "tex_45cb7c3366c6",
"type": "text",
"x": 5374,
"y": 677.25,
"width": 808,
"height": 56.25,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
"strokeStyle": "solid",
