"text": "1. Reposicionar el robot en (65,50) con `Pos`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "1. Reposicionar el robot en (65,50) con `Pos`.",
"lineHeight": 1.25
},
{
"id": "tex_2e8093fd7234",
"type": "text",
"x": 124,
"y": 772.5,
"width": 808,
"height": 18.75,
"angle": 0,
