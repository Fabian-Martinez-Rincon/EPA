"versionNonce": 162825274,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "5. Si no es la última calle, saltar al inicio de la siguiente con `Pos(1,PosCa+1)`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "5. Si no es la última calle, saltar al inicio de la siguiente con `Pos(1,PosCa+1)`.",
