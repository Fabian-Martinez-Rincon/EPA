{Enunciado (Ejemplo 5.9, capítulo 5 - Programación Estructurada): Programe al robot para que aplique el proceso Evaluar a cada una de las esquinas de la ciudad. (El proceso Evaluar, definido en el Ejemplo 5.8, cuenta las flores y los papeles de la esquina y decide qué depositar según cuál cantidad es mayor.)}

programa prueba
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso cuadrado
  comenzar
    repetir 4
      repetir 2
        mover
      derecha
  fin
  proceso torre
  comenzar
    repetir 5
      cuadrado
      Pos(PosAv,PosCa+3)
  fin
  proceso Evaluar
  variables
    flor:numero
    papel:numero
  comenzar
    flor:=5
    papel:=8
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flor:=flor+1
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papel:=papel+1
    si(papel<flor)
      si HayFlorEnLaBolsa
        depositarFlor
    sino
      si(flor=papel)
        si HayPapelEnLaBolsa & HayFlorEnLaBolsa
          depositarFlor
          depositarPapel
        sino
          si HayPapelEnLaBolsa
            depositarPapel
  fin
  proceso RecorrerCalles
  comenzar
    repetir 99
      Evaluar
      mover
    Evaluar
  fin
areas 
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    vacias:numero
  comenzar
    derecha
    repetir 99
      RecorrerCalles
      Pos(1,PosCa+1)
    RecorrerCalles
  fin
variables
  robin:robot1
comenzar
  AsignarArea(robin,ciudad)
  Iniciar(robin,1,1)
fin