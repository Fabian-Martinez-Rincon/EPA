"locked": false,
"text": "→ Restricciones: perímetro completo de la ciudad (100×100); el recorrido termina\napenas se completan los cuatro lados, sin vueltas de más.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: perímetro completo de la ciudad (100×100); el recorrido termina\napenas se completan los cuatro lados, sin vueltas de más.",
"lineHeight": 1.25
},
