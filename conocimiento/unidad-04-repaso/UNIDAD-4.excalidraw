"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Entradas: ninguna leída en tiempo de ejecución; recorrido sobre la calle 20 (avenida\nvariable, de 1 a 100).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución; recorrido sobre la calle 20 (avenida\nvariable, de 1 a 100).",
"lineHeight": 1.25
},
{
