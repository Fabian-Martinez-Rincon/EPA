"locked": false,
"text": "→ Restricciones: no debe modificarse el contenido de ninguna esquina (no se puede usar\n`tomarFlor`/`tomarPapel`).",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: no debe modificarse el contenido de ninguna esquina (no se puede usar\n`tomarFlor`/`tomarPapel`).",
