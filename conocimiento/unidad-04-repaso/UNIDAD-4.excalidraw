"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: la cantidad de esquinas con papel y sin flor, informada con `Informar`.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: la cantidad de esquinas con papel y sin flor, informada con `Informar`.",
"lineHeight": 1.25
},
