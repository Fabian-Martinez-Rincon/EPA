"versionNonce": 903774679,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Restricciones: no se puede modificar el contenido de las esquinas — hay que poder\n\"mirar\" cuánto hay sin alterarlo.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Restricciones: no se puede modificar el contenido de las esquinas — hay que poder\n\"mirar\" cuánto hay sin alterarlo.",
"lineHeight": 1.25
},
{
"id": "tex_298bc23a636e",
