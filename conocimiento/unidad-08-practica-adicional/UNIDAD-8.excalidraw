"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Entradas: ninguna leída en tiempo de ejecución.",
"lineHeight": 1.25
},
{
"id": "tex_9ee2e9267ce5",
"type": "text",
"x": 3274,
"y": 710.25,
"width": 808,
"height": 37.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
