"versionNonce": 969091733,
"isDeleted": false,
"boundElements": null,
"updated": 1,
"link": null,
"locked": false,
"text": "→ Salidas: dos `Informar`: cantidad de esquinas con exactamente 20 flores, y cantidad\nde avenidas con menos de 60 papeles en total.",
"fontSize": 15,
"fontFamily": 2,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 12,
"containerId": null,
"originalText": "→ Salidas: dos `Informar`: cantidad de esquinas con exactamente 20 flores, y cantidad\nde avenidas con menos de 60 papeles en total.",
"lineHeight": 1.25
},
{
"id": "tex_5f4896765bd0",
"type": "text",
"x": 3274,
"y": 751.75,
"width": 808,
"height": 37.5,
"angle": 0,
