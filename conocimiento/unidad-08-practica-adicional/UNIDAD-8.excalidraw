},
{
"id": "tex_35534ef8a4e7",
"type": "text",
"x": 1158,
"y": 674.5,
"width": 199.64,
"height": 17.5,
"angle": 0,
"strokeColor": "#495057",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 1,
